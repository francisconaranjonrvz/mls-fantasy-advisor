{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mls-fantasy-advisor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // El dashboard compilado se sirve desde aqui. Las peticiones a ficheros
  // estaticos son gratis e ilimitadas en Cloudflare: no consumen la cuota de
  // 100.000 peticiones diarias, que solo gastan las que ejecutan el Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },

  "vars": {
    "AI_PROVIDER": "nvidia",
    "SEASON_ID": "2026-27"
  },

  // Workers AI: 10.000 neuronas diarias gratis dentro de la propia Cloudflare.
  //
  // Esta activado para que el asesor funcione sin depender de una clave de
  // NVIDIA. Si NVIDIA_API_KEY existe, manda ella y esto queda de respaldo para
  // cuando se agoten sus creditos; si no existe, es el unico proveedor. El
  // codigo lo detecta solo, ver apps/api/src/providers.ts.
  //
  // El precio de tenerlo activado: obliga a `wrangler dev` a abrir conexion
  // remota, asi que quien solo quiera tocar el codigo en local necesita cuenta
  // de Cloudflare. Merece la pena a cambio de que el chat funcione.
  "ai": { "binding": "AI" }

  // NVIDIA_API_KEY NO va aqui. Se define como secreto:
  //   npx wrangler secret put NVIDIA_API_KEY
  // De esa forma nunca entra en el repositorio, que es publico.
}
