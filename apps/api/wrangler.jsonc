{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mls-fantasy-advisor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // El dashboard compilado se sirve desde aqui. Las peticiones a ficheros
  // estaticos son gratis e ilimitadas en Cloudflare: no consumen la cuota de
  // 100.000 peticiones diarias, que solo gastan las que ejecutan el Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },

  "vars": {
    "AI_PROVIDER": "nvidia",
    "SEASON_ID": "2026-27"
  }

  // El respaldo por Workers AI (10.000 neuronas diarias gratis) esta
  // deliberadamente desactivado por defecto. Ese binding obliga a wrangler a
  // abrir una conexion remota, asi que exige cuenta y token de Cloudflare
  // incluso para `wrangler dev`, y eso rompe el desarrollo local de quien solo
  // quiera tocar el codigo. Para activarlo, descomenta:
  //
  //   "ai": { "binding": "AI" }
  //
  // El codigo ya lo detecta solo: si el binding existe, entra en la cadena de
  // proveedores detras de NVIDIA. Ver apps/api/src/providers.ts.

  // NVIDIA_API_KEY NO va aqui. Se define como secreto:
  //   npx wrangler secret put NVIDIA_API_KEY
  // De esa forma nunca entra en el repositorio, que es publico.
}
