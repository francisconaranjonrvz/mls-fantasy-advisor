# Copia a .env para desarrollo local. NUNCA lo subas (esta en .gitignore).
# En produccion estos valores viven como GitHub Actions secrets.

# --- Acceso a Mister: elige UNA de las dos vias ---

# Via 1 (la habitual): sesion capturada del navegador.
# Necesaria si entras en Mister con "Continuar con Google", porque esa cuenta
# no tiene contrasena nativa. Se genera con:  pnpm capture:session
MISTER_SESSION=

# Via 2: credenciales nativas de Mister. Solo si tu cuenta tiene contrasena
# propia (no vale la contrasena de tu cuenta de Google).
MISTER_EMAIL=
MISTER_PASSWORD=

# Opcional: si lo dejas vacio, el scraper detecta la liga automaticamente.
MISTER_LEAGUE_ID=

# Proveedor de IA (solo lo necesita el Worker, no el scraper)
AI_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-xxxxxxxx
