{
  "name": "mls-fantasy-advisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asesor automatico para la liga fantasy Mister MLS (Malos Ligando Siempre) 26-27",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "ingest": "pnpm --filter @mls/scraper start",
    "ingest:dry": "pnpm --filter @mls/scraper start -- --dry-run",
    "ingest:demo": "pnpm --filter @mls/scraper start -- --demo --dry-run"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "eslint": "^9.34.0",
    "typescript-eslint": "^8.41.0"
  }
}
